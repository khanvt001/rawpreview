{
  "sourceLanguage": "en",
  "strings": {
    "%@ exists but isn't valid XMP, so it was left untouched.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã tồn tại nhưng không phải XMP hợp lệ nên được giữ nguyên."
          }
        }
      }
    },
    "%@ free": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn trống %@"
          }
        }
      }
    },
    "%@ in %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ trong %2$@"
          }
        }
