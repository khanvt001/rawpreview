      }
    },
    "The copy's size doesn't match the original.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dung lượng bản sao không khớp với tệp gốc."
          }
        }
      }
    },
    "The destination drive was disconnected during the copy. Reconnect it and copy again — files already copied are skipped.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đích đã bị ngắt khi đang sao chép. Hãy kết nối lại và sao chép lần nữa — các tệp đã chép sẽ được bỏ qua."
          }
        }
      }
    },
    "The files are moved to the Trash, where they can be put back from Finder.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp được chuyển vào Thùng rác, có thể khôi phục lại từ Finder."
          }
        }
      }
    },
    "The photo as shot": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh gốc như khi chụp"
          }
        }
      }
    },
    "This can’t be undone: files on a memory card are erased, not moved to the Trash, so their space is freed at once.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể hoàn tác: tệp trên thẻ nhớ bị xoá hẳn, không chuyển vào Thùng rác, để giải phóng dung lượng ngay."
          }
        }
      }
    },
    "This file may be damaged or in an unsupported format.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp này có thể bị hỏng hoặc có định dạng không được hỗ trợ."
          }
        }
      }
    },
    "This folder has no RAW, JPEG, HEIF or video files.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục này không có tệp RAW, JPEG, HEIF hay video."
