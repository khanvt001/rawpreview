            "value": "16-bit"
          }
        }
      }
    },
    "16-bit keeps smooth gradients after strong edits, at about twice the file size": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "16-bit giữ chuyển màu mượt sau khi chỉnh mạnh, dung lượng tệp gấp khoảng hai lần"
          }
        }
      }
    },
    "8-bit": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "8-bit"
          }
        }
      }
    },
    "A copy is in progress. Wait for it to finish, or cancel it, before deleting.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang sao chép. Hãy chờ hoàn tất hoặc huỷ trước khi xoá."
          }
        }
      }
    },
    "A copy is in progress. Wait for it to finish, or cancel it, before ejecting.": {
      "localizations": {
