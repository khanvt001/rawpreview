---
import {Picture} from 'astro:assets';
import copyShot from '../assets/screens/copy.png';
import cullShot from '../assets/screens/cull.png';
import previewShot from '../assets/screens/preview.png';
import shareShot from '../assets/screens/share.png';
import {copy, type Lang} from '../i18n/copy';

interface Props {
  lang: Lang;
}
const {lang} = Astro.props;
const t = copy[lang].how;
const shots = {preview: previewShot, cull: cullShot, share: shareShot, copy: copyShot};
---

<section class="section" id="how">
  <div class="container">
    <div class="section-head">
      <p class="label eyebrow">{t.eyebrow}</p>
      <h2 class="display-lg">{t.title}</h2>
    </div>

    <ol class="steps">
      {
        t.steps.map((s) => (
          <li class="step">
            <div class="text">
              <p class="label step-no">{s.step}</p>
              <h3 class="title">{s.title}</h3>
              <p class="body copy">{s.body}</p>
              <div class="extras">
                {'keys' in s && s.keys && (
                  <p class="keys">
                    {s.keys.map((k) => (
                      <kbd>{k}</kbd>
                    ))}
                    <span class="caption">{s.keysLabel}</span>
                  </p>
                )}
                {s.readout && (
                  <p class="readout">
                    <span class="exif">{s.readout}</span>
                    {'readoutLabel' in s && s.readoutLabel && <span class="caption">{s.readoutLabel}</span>}
                  </p>
                )}
              </div>
            </div>
            <div class="window">
              <Picture
                src={shots[s.id as keyof typeof shots]}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[800, 1200, 1600]}
                sizes="(max-width: 860px) 100vw, 680px"
                alt={s.alt}
              />
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .step {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-12);
    align-items: center;
  }

  .step:nth-child(even) .text {
    order: 2;
  }

  .step-no {
    color: var(--amber-ink);
    text-transform: uppercase;
  }

  .title {
    margin-top: var(--space-3);
  }

  .copy {
    margin-top: var(--space-4);
    color: var(--ink-muted);
    max-width: 44ch;
  }

  .extras {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .keys {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .keys .caption {
    margin-left: var(--space-1);
    color: var(--ink-muted);
  }

  @media (max-width: 860px) {
    .steps {
      gap: var(--space-16);
    }

    .step {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .step:nth-child(even) .text {
      order: 0;
    }
  }
</style>
