---
import {Image} from 'astro:assets';
import appIcon from '../assets/app-icon.png';
import {copy, type Lang} from '../i18n/copy';
import {DOWNLOAD_URL, GITHUB_URL, homeOf} from '../site';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const {lang} = Astro.props;
const t = copy[lang];
const other: Lang = lang === 'en' ? 'vi' : 'en';
---

<header class="header">
  <div class="container bar">
    <a class="brand" href={homeOf(lang)}>
      <Image src={appIcon} alt="" width={32} height={32} />
      <span>RawPreview</span>
    </a>

    <nav class="nav" aria-label="RawPreview">
      <a href="#how">{t.nav.how}</a>
      <a href="#looks">{t.nav.looks}</a>
      <a href="#formats">{t.nav.formats}</a>
      <a href="#faq">{t.nav.faq}</a>
    </nav>

    <div class="tools">
      <a class="tool" href={homeOf(other)} hreflang={other} lang={other} aria-label={t.langSwitch.label}>
        <Icon name="globe" size={18} />
        <span>{t.langSwitch.short}</span>
      </a>
      <a class="tool" href={GITHUB_URL} aria-label={t.nav.github} title={t.nav.github}>
        <Icon name="github" size={18} />
      </a>
      <button
        class="tool"
        type="button"
        data-theme-toggle
        data-label-dark={t.theme.toDark}
        data-label-light={t.theme.toLight}
        aria-label={t.theme.toLight}
      >
        <Icon name="sun" size={18} class="when-dark" />
        <Icon name="moon" size={18} class="when-light" />
      </button>
      <a class="btn btn-secondary btn-small download" href={DOWNLOAD_URL}>
        <Icon name="download" size={16} />
        {t.nav.download}
      </a>
    </div>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const root = document.documentElement;
  const sync = () => {
    const light = root.dataset.theme === 'light';
    button.setAttribute('aria-label', light ? button.dataset.labelDark! : button.dataset.labelLight!);
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', light ? '#f2f3f5' : '#14171c');
  };
  sync();
  button.addEventListener('click', () => {
    const light = root.dataset.theme !== 'light';
    if (light) root.dataset.theme = 'light';
    else delete root.dataset.theme;
    try {
      localStorage.setItem('theme', light ? 'light' : 'dark');
    } catch {}
    sync();
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font: 800 19px/1 var(--font-display);
    letter-spacing: -0.02em;
  }

  .brand img {
    width: 32px;
    height: 32px;
  }

  .nav {
    display: flex;
    gap: var(--space-6);
    margin-right: auto;
  }

  .nav a,
  .tool {
    color: var(--ink-muted);
    text-decoration: none;
    font: 500 14px/20px var(--font-sans);
    transition: color 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .nav a:hover,
  .tool:hover {
    color: var(--ink);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .tool {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding-inline: 10px;
    background: none;
    border: 0;
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .tool span {
    font: 700 12px/1 var(--font-mono);
  }

  :global(:root[data-theme='light'] .when-dark),
  :global(:root:not([data-theme='light']) .when-light) {
    display: none;
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }

    .tools {
      margin-left: auto;
    }
  }

  @media (max-width: 420px) {
    .download {
      display: none;
    }
  }
</style>
