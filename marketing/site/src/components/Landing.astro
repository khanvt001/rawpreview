---
import type {Lang} from '../i18n/copy';
import Base from '../layouts/Base.astro';
import Faq from './Faq.astro';
import Final from './Final.astro';
import Footer from './Footer.astro';
import Formats from './Formats.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Install from './Install.astro';
import Looks from './Looks.astro';
import Steps from './Steps.astro';
import Why from './Why.astro';

interface Props {
  lang: Lang;
}
const {lang} = Astro.props;
---

<Base lang={lang}>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <Why lang={lang} />
    <Steps lang={lang} />
    <Looks lang={lang} />
    <Formats lang={lang} />
    <Faq lang={lang} />
    <Final lang={lang} />
    <Install lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
